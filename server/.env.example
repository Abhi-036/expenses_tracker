# Local development defaults (copy to server/.env and fill in)
PORT=5000
NODE_ENV=development

# Local MongoDB or a MongoDB Atlas URI. Never commit the real value.
MONGO_URI=<your_mongodb_URI>

# Use a long random secret.
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Local frontend URL (CORS)
CLIENT_URL=http://localhost:5173
